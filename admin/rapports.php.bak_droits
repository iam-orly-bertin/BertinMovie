                    <div class="rpt-seg">
                        <a href="?type=comparatif&mode=periodes"
                            class="<?= $mode === 'periodes' ? 'on' : '' ?>">Périodes</a>
                        <a href="?type=comparatif&mode=realisateurs"
                            class="<?= $mode === 'realisateurs' ? 'on' : '' ?>">Réalisateurs</a>
