                    <small>Groupe A</small>
                    <b><?= e($cmp[0]['label']) ?></b>
                    <span><i class="fas fa-film"></i> <?= (int) ($cmp[0]['stats']['nb_films'] ?? 0) ?> film(s)</span>
                </div>
                <div class="rpt-vsbadge">VS</div>
                <div class="rpt-side rpt-b">
                    <small>Groupe B</small>
                    <b><?= e($cmp[1]['label']) ?></b>
                    <span><i class="fas fa-film"></i> <?= (int) ($cmp[1]['stats']['nb_films'] ?? 0) ?> film(s)</span>
                </div>
            </div>

            <div class="rpt-card">
                <h3 class="rpt-card-h"><i class="fas fa-chart-bar"></i> Comparaison graphique</h3>
                <div class="rpt-chart" id="chartBox"><canvas id="chart"></canvas></div>
            </div>

            <div class="rpt-card">
                <h3 class="rpt-card-h"><i class="fas fa-table"></i> Indicateurs</h3>
                <div class="rpt-twrap">
                    <table class="rpt-table">
                        <thead>
                            <tr>
                                <th>Indicateur</th>
                                <th><span class="rpt-dot" style="background:#3b82f6"></span>A</th>
                                <th><span class="rpt-dot" style="background:#8b5cf6"></span>B</th>
                                <th>Écart</th>
                                <th>Variation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($METS as $k => $lab):
                                $va = (float) ($cmp[0]['stats'][$k] ?? 0);
                                $vb = (float) ($cmp[1]['stats'][$k] ?? 0);
                                $diff = round($vb - $va, 1);
                                $pc = $diff > 0 ? 'up' : ($diff < 0 ? 'down' : 'flat'); ?>
                                <tr>
                                    <td><?= e($lab) ?></td>
                                    <td><?= e($cmp[0]['stats'][$k] ?? 0) ?></td>
                                    <td><?= e($cmp[1]['stats'][$k] ?? 0) ?></td>
                                    <td class="<?= $diff > 0 ? 'rpt-up' : ($diff < 0 ? 'rpt-down' : '') ?>">
                                        <?= ($diff > 0 ? '+' : '') . $diff ?></td>
                                    <td><span class="rpt-pill <?= $pc ?>"><?= e(variation($va, $vb)) ?></span></td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="rpt-cols">
                <?php foreach ($cmp as $i => $c):
                    $mx = $c['cats'] ? max(array_map('intval', array_column($c['cats'], 'nb'))) : 0; ?>
                    <div class="rpt-card">
                        <h3 class="rpt-card-h"><i class="fas fa-tags"></i> Top catégories — <?= $i === 0 ? 'A' : 'B' ?></h3>
