                                                <td>
                                                    <div class="rpt-part"><em><?= e($cell) ?> %</em><span><i
                                                                style="width:<?= max(0, min(100, (float) $cell)) ?>%"></i></span></div>
                                                </td>
                                            <?php else: ?>
                                                <td><?= e($cell) ?></td>
                                            <?php endif; ?>
                                        <?php endforeach; ?>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                </div>
