                </div>
                <div class="rpt-card">
                    <h3 class="rpt-card-h"><i class="fas fa-table"></i> Détail</h3>
                    <div class="rpt-twrap">
                        <table class="rpt-table">
                            <thead>
                                <tr><?php foreach ($table['head'] as $hd): ?>
                                        <th><?= e($hd) ?></th><?php endforeach; ?>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach ($table['rows'] as $row): ?>
                                    <tr>
