                                <span class="hx-lab"><?= $lab ?></span>
                                <label class="hx-field"><i
                                        class="fas <?= $mode === 'realisateurs' ? 'fa-user-tie' : 'fa-user' ?>"></i>
                                    <select name="<?= $nm ?>">
                                        <?php foreach ($liste as $x): ?>
                                            <option value="<?= (int) $x['id'] ?>" <?= $sel === (int) $x['id'] ? 'selected' : '' ?>>
                                                <?= e($x['nom']) ?></option>
