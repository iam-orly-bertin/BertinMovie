                                </div>
                                <div class="rpt-track"><i
                                        style="width:<?= $mx > 0 ? round($t['nb'] * 100 / $mx) : 0 ?>%;--bc:<?= $i === 0 ? '#3b82f6' : '#8b5cf6' ?>"></i>
                                </div>
                            </div>
                        <?php endforeach; ?>
                        <?php if (!$c['cats']): ?>
                            <p class="rpt-hint">Aucune donnée</p><?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php /* ================= PRÉVISION ================= */ if ($type === 'prevision'): ?>
            <div class="rpt-panel rpt-noprint">
                <form class="rpt-form" method="get">
                    <input type="hidden" name="type" value="prevision">
                    <div>
                        <span class="hx-lab">Indicateur</span>
                        <label class="hx-field"><i class="fas fa-chart-line"></i>
                            <select name="met" onchange="this.form.submit()">
                                <?php foreach ($PM as $k => $l): ?>
                                    <option value="<?= $k ?>" <?= $met === $k ? 'selected' : '' ?>><?= e($l) ?></option>
                                <?php endforeach; ?>
                            </select>
                        </label>
                    </div>
                    <div>
                        <span class="hx-lab">Années à prévoir</span>
                        <label class="hx-field"><i class="fas fa-forward"></i>
                            <input type="number" name="nb" min="1" max="5" value="<?= $h ?>"></label>
                    </div>
                    <div class="rpt-full">
                        <button class="hx-btn hx-btn--primary"><i class="fas fa-calculator"></i> Calculer</button>
                    </div>
                </form>
            </div>

            <?php if (!$ok): ?>
                <div class="hx-empty">
                    <div class="hx-empty-ico"><i class="fas fa-chart-line"></i></div>
                    <h3>Pas assez de données</h3>
                    <p>Il faut des films répartis sur au moins 3 années différentes (date de sortie) pour calculer une
                        prévision.</p>
                </div>
            <?php else:
                $premAn = array_key_first($prev);
                $r2c = $reg['r2'] >= 0.7 ? 'green' : ($reg['r2'] >= 0.5 ? 'blue' : 'orange'); ?>
                <div class="hx-stats">
                    <div class="hx-stat hx-stat--violet">
                        <div class="hx-stat-ico"><i class="fas fa-arrow-trend-up"></i></div>
                        <div><strong><?= ($reg['a'] > 0 ? '+' : '') . round($reg['a'], 2) ?></strong><span>Pente / an</span>
                        </div>
                    </div>
                    <div class="hx-stat hx-stat--<?= $r2c ?>">
                        <div class="hx-stat-ico"><i class="fas fa-bullseye"></i></div>
                        <div><strong><?= round($reg['r2'], 2) ?></strong><span>Fiabilité (R²)</span></div>
                    </div>
                    <div class="hx-stat hx-stat--blue">
                        <div class="hx-stat-ico"><i class="fas fa-wand-magic-sparkles"></i></div>
                        <div><strong><?= e($prev[$premAn]) ?><small> en <?= (int) $premAn ?></small></strong><span>Prochaine
                                prévision</span></div>
                    </div>
                </div>

                <div class="rpt-card">
                    <h3 class="rpt-card-h"><i class="fas fa-chart-line"></i> <?= e($PM[$met]) ?></h3>
                    <div class="rpt-chart" id="chartBox"><canvas id="chart"></canvas></div>
                </div>

                <div class="rpt-card">
                    <h3 class="rpt-card-h"><i class="fas fa-table"></i> Réel et prévisions</h3>
                    <div class="rpt-twrap">
                        <table class="rpt-table">
                            <thead>
                                <tr>
                                    <th>Année</th>
                                    <th><?= e($PM[$met]) ?></th>
                                    <th>Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach ($xs as $i => $x): ?>
                                    <tr>
                                        <td><?= $x ?></td>
                                        <td><?= e($ys[$i]) ?></td>
                                        <td><span class="rpt-pill flat">Réel</span></td>
                                    </tr>
                                <?php endforeach; ?>
                                <?php foreach ($prev as $y => $v): ?>
                                    <tr>
                                        <td><?= $y ?></td>
                                        <td><strong><?= e($v) ?></strong></td>
                                        <td><span class="rpt-pill prev">Prévision</span></td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                    <p class="rpt-note">
                        Méthode : régression linéaire sur <?= count($xs) ?> années. Une prévision n'est qu'une estimation basée
                        sur le passé.
                    </p>
                </div>

                <?php if ($reg['r2'] < 0.5): ?>
                    <div class="hx-alert hx-alert--warn">
                        <i class="fas fa-triangle-exclamation"></i>
                        <div>R² faible : la tendance est peu fiable, prenez la prévision avec prudence.</div>
                    </div>
                <?php endif; ?>
            <?php endif; ?>
        <?php endif; ?>

    </div><!-- /.content -->

    <script>
        (function () {
            const CFG = <?= json_encode($jsCfg) ?>;
            const el = document.getElementById('chart');
            if (!el || !CFG) return;

            const box = document.getElementById('chartBox');
            const small = window.matchMedia('(max-width: 640px)').matches;
            box.style.height = (small && !CFG.horizontal ? Math.min(CFG.height, 280) : CFG.height) + 'px';

            const palette = ['#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ef4444'];
            let chart = null;

            function colors() {
                const dark = document.body.classList.contains('dark-mode');
                return {
                    txt: dark ? '#94a3b8' : '#64748b',
                    grid: dark ? 'rgba(148,163,184,.15)' : 'rgba(100,116,139,.15)',
                    leg: dark ? '#e2e8f0' : '#0f172a',
                    tip: dark ? '#0f172a' : '#0f172a'
                };
            }

            function draw() {
                if (chart) chart.destroy();
                const c = colors();
                Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
                Chart.defaults.font.size = small ? 11 : 12;
                const axis = { ticks: { color: c.txt }, grid: { color: c.grid, drawBorder: false }, border: { display: false } };
                const common = {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { labels: { color: c.leg, usePointStyle: true, boxWidth: 8, padding: 16 } },
                        tooltip: { backgroundColor: c.tip, titleColor: '#fff', bodyColor: '#e2e8f0', padding: 12, cornerRadius: 10, boxPadding: 6 }
                    }
                };

                if (CFG.kind === 'forecast') {
                    const n = CFG.reel.length;
                    chart = new Chart(el, {
                        type: 'line',
                        data: {
                            labels: CFG.labels,
                            datasets: [
                                { label: 'Réel', data: CFG.reel, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,.12)', fill: true, borderWidth: 3, pointRadius: 3, pointBackgroundColor: '#3b82f6', tension: .35 },
                                { label: 'Tendance', data: CFG.tendance, borderColor: '#94a3b8', borderDash: [4, 4], borderWidth: 2, pointRadius: 0 },
                                { label: 'Prévision', data: [...Array(n - 1).fill(null), CFG.reel[n - 1], ...CFG.prev], borderColor: '#8b5cf6', backgroundColor: '#8b5cf6', borderDash: [8, 5], borderWidth: 3, pointRadius: 4, tension: .35 }
                            ]
                        },
                        options: Object.assign({}, common, { scales: { x: axis, y: Object.assign({ beginAtZero: true }, axis) } })
                    });
                } else {
                    const single = CFG.datasets.length === 1;
                    const ds = CFG.datasets.map((d, i) => Object.assign({}, d, {
                        backgroundColor: single ? '#3b82f6' : palette[i % palette.length],
                        hoverBackgroundColor: single ? '#2563eb' : palette[i % palette.length],
                        borderRadius: 8,
                        borderSkipped: false,
                        maxBarThickness: 46
                    }));
                    chart = new Chart(el, {
                        type: 'bar',
                        data: { labels: CFG.labels, datasets: ds },
                        options: Object.assign({}, common, {
                            indexAxis: CFG.horizontal ? 'y' : 'x',
                            plugins: Object.assign({}, common.plugins, { legend: { display: !single, labels: common.plugins.legend.labels } }),
                            scales: { x: Object.assign({ beginAtZero: true }, axis), y: Object.assign({ beginAtZero: true }, axis) }
                        })
                    });
                }
            }

            draw();
            // Redessiner quand on bascule en mode sombre / clair
            new MutationObserver(draw).observe(document.body, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
</body>

</html>