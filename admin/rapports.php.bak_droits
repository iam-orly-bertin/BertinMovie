<?php
// Même démarrage de session que login.php : l'admin est connecté avec le cookie BM_ADMIN.
// Si on fait un simple session_start(), PHP ouvre une autre session (PHPSESSID) => "pas connecté" => retour à l'index.
if (file_exists(__DIR__ . '/../includes/session_boot.php')) {
    if (!defined('BM_SESSION_NAME')) {
        define('BM_SESSION_NAME', 'BM_ADMIN');
    }
    require_once __DIR__ . '/../includes/session_boot.php';
} elseif (session_status() === PHP_SESSION_NONE) {
    session_start();
}
require_once __DIR__ . '/../connexion.php';
require_once __DIR__ . '/../includes/auth_check.php';
require_once __DIR__ . '/../includes/update_session.php';

if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'admin') {
    header("Location: ../index.php");
    exit();
}
if (isset($_SESSION['user_id'])) {
    updateUserSession($pdo, $_SESSION['user_id']);
}

/* =========================================================
   OUTILS
   Ce fichier travaille UNIQUEMENT sur : film, acteur,
   realisateur (+ categorie, langue, film_acteur).
   Aucune table vidéo n'est utilisée.
========================================================= */
define('NF', "(f.is_deleted = 0 OR f.is_deleted IS NULL)"); // films non supprimés
$erreurs = [];

function e($s): string
{
    return htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');
}

// Exécute une requête préparée ; en cas d'erreur SQL, on garde le message pour l'afficher à l'admin
function q(PDO $pdo, string $sql, array $params = []): array
{
    global $erreurs;
    try {
        $s = $pdo->prepare($sql);
        $s->execute($params);
        return $s->fetchAll();
    } catch (PDOException $ex) {
        $erreurs[] = $ex->getMessage();
        error_log('Rapport erreur : ' . $ex->getMessage());
        return [];
    }
}

// Statistiques d'un ensemble de films défini par une condition WHERE (alias f)
function statsFilms(PDO $pdo, string $where, array $p): array
{
    $r = q($pdo, "SELECT COUNT(*) AS nb_films,
                         ROUND(AVG(f.duree), 1) AS duree_moy,
                         COALESCE(SUM(f.duree), 0) AS duree_tot,
                         COUNT(DISTINCT f.id_realisateur) AS nb_real,
                         COUNT(DISTINCT f.id_categorie) AS nb_cat,
                         COUNT(DISTINCT f.id_langue) AS nb_langues
                  FROM film f WHERE " . NF . " AND $where", $p);
    $s = $r[0] ?? [];
    $a = q($pdo, "SELECT COUNT(DISTINCT fa.id_acteur) AS n
                  FROM film_acteur fa JOIN film f ON f.id_film = fa.id_film
                  WHERE " . NF . " AND $where", $p);
    $s['nb_acteurs'] = $a[0]['n'] ?? 0;
    return $s;
}

// Régression linéaire y = a*x + b  (+ R²)
function regression(array $x, array $y): array
{
    $n = count($x);
    if ($n < 2)
        return ['a' => 0, 'b' => $y[0] ?? 0, 'r2' => 0];
    $mx = array_sum($x) / $n;
    $my = array_sum($y) / $n;
    $sxy = $sxx = 0;
    for ($i = 0; $i < $n; $i++) {
        $sxy += ($x[$i] - $mx) * ($y[$i] - $my);
        $sxx += ($x[$i] - $mx) ** 2;
    }
    $a = $sxx == 0 ? 0 : $sxy / $sxx;
    $b = $my - $a * $mx;
    $ssT = $ssR = 0;
    for ($i = 0; $i < $n; $i++) {
        $ssT += ($y[$i] - $my) ** 2;
        $ssR += ($y[$i] - ($a * $x[$i] + $b)) ** 2;
    }
    return ['a' => $a, 'b' => $b, 'r2' => $ssT == 0 ? 0 : 1 - $ssR / $ssT];
}

function variation($a, $b): string
{
    $a = (float) $a;
    $b = (float) $b;
    if ($a == 0)
        return $b == 0 ? '0 %' : 'nouveau';
    $v = round((($b - $a) / $a) * 100, 1);
    return ($v > 0 ? '+' : '') . $v . ' %';
}

// Construit une URL en gardant les paramètres actuels (affichage uniquement)
function qs(array $over): string
{
    return '?' . http_build_query(array_merge($_GET, $over));
}

/* =========================================================
   DONNÉES DE BASE
========================================================= */
$type = $_GET['type'] ?? 'periodique';
if (!in_array($type, ['periodique', 'personnalise', 'comparatif', 'prevision'], true))
    $type = 'periodique';

$bornes = q($pdo, "SELECT MIN(YEAR(f.date_sortie)) AS mn, MAX(YEAR(f.date_sortie)) AS mx
                   FROM film f WHERE " . NF . " AND f.date_sortie IS NOT NULL")[0] ?? [];
$anMax = (int) ($bornes['mx'] ?? 0);
$anMin = (int) ($bornes['mn'] ?? 0);
if ($anMax === 0) {
    $anMin = $anMax = (int) date('Y');
}

$categories = q($pdo, "SELECT id_categorie, nom_categorie FROM categorie ORDER BY nom_categorie");
$langues = q($pdo, "SELECT id_langue, nom_langue FROM langue ORDER BY nom_langue");

$table = ['head' => [], 'rows' => []];   // tableau générique (affichage + CSV)
$chart = ['type' => 'bar', 'labels' => [], 'datasets' => [], 'horizontal' => false];

/* =========================================================
   1. RAPPORTS PÉRIODIQUES  (sur la date de sortie des films)
========================================================= */
if ($type === 'periodique') {
    $freq = ($_GET['freq'] ?? 'annuel') === 'mensuel' ? 'mensuel' : 'annuel';
    $annee = (int) ($_GET['annee'] ?? $anMax);
    if ($annee < 1850 || $annee > 2200)
        $annee = $anMax;

    if ($freq === 'annuel') {
        $d = max($anMin, $anMax - 19);
        $labels = array_map('strval', range($d, $anMax));
        $fmt = '%Y';
        $w = "YEAR(f.date_sortie) BETWEEN ? AND ?";
        $p = [$d, $anMax];
    } else {
        $labels = [];
        for ($m = 1; $m <= 12; $m++)
            $labels[] = sprintf('%d-%02d', $annee, $m);
        $fmt = '%Y-%m';
        $w = "YEAR(f.date_sortie) = ?";
        $p = [$annee];
    }

    $rows = q($pdo, "SELECT DATE_FORMAT(f.date_sortie, '$fmt') AS per, COUNT(*) AS nb,
                            ROUND(AVG(f.duree), 1) AS dm, COUNT(DISTINCT f.id_realisateur) AS nr,
                            COUNT(DISTINCT f.id_categorie) AS nc, COUNT(DISTINCT f.id_langue) AS nl
                     FROM film f WHERE " . NF . " AND f.date_sortie IS NOT NULL AND $w
                     GROUP BY per", $p);
    $act = q($pdo, "SELECT DATE_FORMAT(f.date_sortie, '$fmt') AS per, COUNT(DISTINCT fa.id_acteur) AS na
                    FROM film_acteur fa JOIN film f ON f.id_film = fa.id_film
                    WHERE " . NF . " AND f.date_sortie IS NOT NULL AND $w
                    GROUP BY per", $p);
    $R = [];
    foreach ($rows as $r)
        $R[$r['per']] = $r;
    $A = [];
    foreach ($act as $r)
        $A[$r['per']] = $r['na'];

    $table['head'] = ['Période', 'Films sortis', 'Durée moyenne (min)', 'Réalisateurs', 'Acteurs', 'Catégories', 'Langues'];
    $vals = [];
    foreach ($labels as $lab) {
        $r = $R[$lab] ?? null;
        $table['rows'][] = [$lab, $r['nb'] ?? 0, $r['dm'] ?? '-', $r['nr'] ?? 0, $A[$lab] ?? 0, $r['nc'] ?? 0, $r['nl'] ?? 0];
        $vals[] = (int) ($r['nb'] ?? 0);
    }
    $chart['labels'] = $labels;
    $chart['datasets'] = [['label' => 'Films sortis', 'data' => $vals]];

    // Instantané global
    $snap = [
        'films' => q($pdo, "SELECT COUNT(*) AS n FROM film f WHERE " . NF)[0]['n'] ?? 0,
        'acteurs' => q($pdo, "SELECT COUNT(*) AS n FROM acteur")[0]['n'] ?? 0,
        'real' => q($pdo, "SELECT COUNT(*) AS n FROM realisateur")[0]['n'] ?? 0,
        'sans_date' => q($pdo, "SELECT COUNT(*) AS n FROM film f WHERE " . NF . " AND f.date_sortie IS NULL")[0]['n'] ?? 0,
    ];
}

/* =========================================================
   2. RAPPORTS PERSONNALISÉS
========================================================= */
if ($type === 'personnalise') {
    $groupes = [
        'films' => ['categorie' => 'Par catégorie', 'langue' => 'Par langue', 'realisateur' => 'Par réalisateur', 'annee' => 'Par année de sortie'],
        'acteurs' => ['sexe' => 'Par sexe', 'top' => 'Top acteurs (nombre de films)'],
        'realisateurs' => ['nationalite' => 'Par nationalité', 'top' => 'Top réalisateurs (nombre de films)'],
    ];
    $entite = in_array($_GET['entite'] ?? '', array_keys($groupes), true) ? $_GET['entite'] : 'films';
    $groupe = isset($groupes[$entite][$_GET['groupe'] ?? '']) ? $_GET['groupe'] : array_key_first($groupes[$entite]);

    $cd = ($_GET['c_debut'] ?? '') !== '' ? (int) $_GET['c_debut'] : null;
    $cf = ($_GET['c_fin'] ?? '') !== '' ? (int) $_GET['c_fin'] : null;
    $cc = (int) ($_GET['cat'] ?? 0);
    $cl = (int) ($_GET['lang'] ?? 0);

    $res = [];
    if ($entite === 'films') {
        $w = [NF];
        $p = [];
        if ($cd !== null) {
            $w[] = "YEAR(f.date_sortie) >= ?";
            $p[] = $cd;
        }
        if ($cf !== null) {
            $w[] = "YEAR(f.date_sortie) <= ?";
            $p[] = $cf;
        }
        if ($cc > 0) {
            $w[] = "f.id_categorie = ?";
            $p[] = $cc;
        }
        if ($cl > 0) {
            $w[] = "f.id_langue = ?";
            $p[] = $cl;
        }
        $expr = [
            'categorie' => "COALESCE(c.nom_categorie, 'Non défini')",
            'langue' => "COALESCE(l.nom_langue, 'Non défini')",
            'realisateur' => "COALESCE(CONCAT(r.prenom, ' ', r.nom), 'Non défini')",
            'annee' => "COALESCE(CAST(YEAR(f.date_sortie) AS CHAR), 'Inconnue')",
        ][$groupe];
        $res = q($pdo, "SELECT $expr AS libelle, COUNT(*) AS nb, ROUND(AVG(f.duree), 1) AS dm
                        FROM film f
                        LEFT JOIN categorie c ON c.id_categorie = f.id_categorie
                        LEFT JOIN langue l ON l.id_langue = f.id_langue
                        LEFT JOIN realisateur r ON r.id_realisateur = f.id_realisateur
                        WHERE " . implode(' AND ', $w) . "
                        GROUP BY libelle
                        ORDER BY " . ($groupe === 'annee' ? 'libelle ASC' : 'nb DESC') . " LIMIT 50", $p);
        $table['head'] = ['Libellé', 'Nombre de films', 'Durée moyenne (min)', 'Part (%)'];
    } elseif ($entite === 'acteurs') {
        if ($groupe === 'sexe') {
            $res = q($pdo, "SELECT COALESCE(NULLIF(a.sexe, ''), 'Non défini') AS libelle, COUNT(*) AS nb
                            FROM acteur a GROUP BY libelle ORDER BY nb DESC");
            $table['head'] = ['Libellé', 'Nombre d\'acteurs', 'Part (%)'];
        } else {
            $res = q($pdo, "SELECT CONCAT(a.prenom, ' ', a.nom) AS libelle, COUNT(f.id_film) AS nb
                            FROM acteur a
                            LEFT JOIN film_acteur fa ON fa.id_acteur = a.id_acteur
                            LEFT JOIN film f ON f.id_film = fa.id_film AND " . NF . "
                            GROUP BY a.id_acteur, libelle ORDER BY nb DESC, libelle LIMIT 20");
            $table['head'] = ['Acteur', 'Nombre de films', 'Part (%)'];
        }
    } else { // realisateurs
        if ($groupe === 'nationalite') {
            $res = q($pdo, "SELECT COALESCE(NULLIF(r.nationalite, ''), 'Non définie') AS libelle, COUNT(*) AS nb
                            FROM realisateur r GROUP BY libelle ORDER BY nb DESC LIMIT 50");
            $table['head'] = ['Nationalité', 'Nombre de réalisateurs', 'Part (%)'];
        } else {
            $res = q($pdo, "SELECT CONCAT(r.prenom, ' ', r.nom) AS libelle, COUNT(f.id_film) AS nb
                            FROM realisateur r
                            LEFT JOIN film f ON f.id_realisateur = r.id_realisateur AND " . NF . "
                            GROUP BY r.id_realisateur, libelle ORDER BY nb DESC, libelle LIMIT 20");
            $table['head'] = ['Réalisateur', 'Nombre de films', 'Part (%)'];
        }
    }

    $total = array_sum(array_column($res, 'nb'));
    $vals = [];
    foreach ($res as $r) {
        $part = $total > 0 ? round($r['nb'] * 100 / $total, 1) : 0;
        $table['rows'][] = $entite === 'films'
            ? [$r['libelle'], $r['nb'], $r['dm'] ?? '-', $part]
            : [$r['libelle'], $r['nb'], $part];
        $vals[] = (int) $r['nb'];
    }
    $chart['labels'] = array_column($res, 'libelle');
    $chart['datasets'] = [['label' => 'Nombre', 'data' => $vals]];
    $chart['horizontal'] = count($res) > 8;
}

/* =========================================================
   3. ANALYSE COMPARATIVE
========================================================= */
$METS = [
    'nb_films' => 'Films',
    'duree_moy' => 'Durée moyenne (min)',
    'duree_tot' => 'Durée totale (min)',
    'nb_real' => 'Réalisateurs',
    'nb_acteurs' => 'Acteurs',
    'nb_cat' => 'Catégories',
    'nb_langues' => 'Langues',
];
if ($type === 'comparatif') {
    $mode = in_array($_GET['mode'] ?? '', ['periodes', 'realisateurs', 'acteurs'], true) ? $_GET['mode'] : 'periodes';
    $listeReal = q($pdo, "SELECT id_realisateur AS id, CONCAT(prenom, ' ', nom) AS nom FROM realisateur ORDER BY nom, prenom");
    $listeAct = q($pdo, "SELECT id_acteur AS id, CONCAT(prenom, ' ', nom) AS nom FROM acteur ORDER BY nom, prenom");

    $a1 = (int) ($_GET['a1'] ?? max($anMin, $anMax - 1));
    $a2 = (int) ($_GET['a2'] ?? max($anMin, $anMax - 1));
    $b1 = (int) ($_GET['b1'] ?? $anMax);
    $b2 = (int) ($_GET['b2'] ?? $anMax);
    if ($a1 > $a2)
        [$a1, $a2] = [$a2, $a1];
    if ($b1 > $b2)
        [$b1, $b2] = [$b2, $b1];

    $liste = $mode === 'realisateurs' ? $listeReal : $listeAct;
    $idA = (int) ($_GET['id_a'] ?? ($liste[0]['id'] ?? 0));
    $idB = (int) ($_GET['id_b'] ?? ($liste[1]['id'] ?? ($liste[0]['id'] ?? 0)));
    $nomDe = function (array $l, int $id) {
        foreach ($l as $x)
            if ((int) $x['id'] === $id)
                return $x['nom'];
        return '#' . $id;
    };

    if ($mode === 'periodes') {
        $defs = [
            ['label' => $a1 === $a2 ? "$a1" : "$a1–$a2", 'where' => "YEAR(f.date_sortie) BETWEEN ? AND ?", 'p' => [$a1, $a2]],
            ['label' => $b1 === $b2 ? "$b1" : "$b1–$b2", 'where' => "YEAR(f.date_sortie) BETWEEN ? AND ?", 'p' => [$b1, $b2]],
        ];
    } elseif ($mode === 'realisateurs') {
        $defs = [
            ['label' => $nomDe($listeReal, $idA), 'where' => "f.id_realisateur = ?", 'p' => [$idA]],
            ['label' => $nomDe($listeReal, $idB), 'where' => "f.id_realisateur = ?", 'p' => [$idB]],
        ];
    } else {
        $defs = [
            ['label' => $nomDe($listeAct, $idA), 'where' => "f.id_film IN (SELECT id_film FROM film_acteur WHERE id_acteur = ?)", 'p' => [$idA]],
            ['label' => $nomDe($listeAct, $idB), 'where' => "f.id_film IN (SELECT id_film FROM film_acteur WHERE id_acteur = ?)", 'p' => [$idB]],
        ];
    }

    $cmp = [];
    foreach ($defs as $i => $df) {
        $cmp[$i] = [
            'label' => $df['label'],
            'stats' => statsFilms($pdo, $df['where'], $df['p']),
            'cats' => q($pdo, "SELECT COALESCE(c.nom_categorie, 'Non défini') AS libelle, COUNT(*) AS nb
                                FROM film f LEFT JOIN categorie c ON c.id_categorie = f.id_categorie
                                WHERE " . NF . " AND " . $df['where'] . "
                                GROUP BY libelle ORDER BY nb DESC LIMIT 5", $df['p']),
        ];
    }
    $chartKeys = ['nb_films', 'nb_real', 'nb_acteurs', 'nb_cat', 'nb_langues'];
    $chart['labels'] = array_map(fn($k) => $METS[$k], $chartKeys);
    foreach ($cmp as $c) {
        $chart['datasets'][] = ['label' => $c['label'], 'data' => array_map(fn($k) => (float) ($c['stats'][$k] ?? 0), $chartKeys)];
    }
}

/* =========================================================
   4. PRÉVISIONS (nombre de films par année de sortie, etc.)
========================================================= */
if ($type === 'prevision') {
    $PM = ['nb_films' => 'Nombre de films sortis', 'duree_moy' => 'Durée moyenne des films (min)', 'nb_real' => 'Réalisateurs actifs'];
    $met = isset($PM[$_GET['met'] ?? '']) ? $_GET['met'] : 'nb_films';
    $h = max(1, min(5, (int) ($_GET['nb'] ?? 3)));
    $d = max($anMin, $anMax - 14);

    $rows = q($pdo, "SELECT YEAR(f.date_sortie) AS an, COUNT(*) AS nb_films, ROUND(AVG(f.duree), 1) AS duree_moy,
                            COUNT(DISTINCT f.id_realisateur) AS nb_real
                     FROM film f WHERE " . NF . " AND f.date_sortie IS NOT NULL AND YEAR(f.date_sortie) BETWEEN ? AND ?
                     GROUP BY an ORDER BY an", [$d, $anMax]);
    $par = [];
    foreach ($rows as $r)
        $par[(int) $r['an']] = (float) $r[$met];

    $xs = $ys = [];
    for ($y = $d; $y <= $anMax; $y++) {
        if (isset($par[$y])) {
            $xs[] = $y;
            $ys[] = $par[$y];
        } elseif ($met !== 'duree_moy') {
            $xs[] = $y;
            $ys[] = 0;
        }   // année sans film = 0
    }
    $ok = count($xs) >= 3;
    $prev = [];
    $tendance = [];
    $reg = ['a' => 0, 'b' => 0, 'r2' => 0];
    if ($ok) {
        $reg = regression($xs, $ys);
        for ($i = 1; $i <= $h; $i++) {
            $y = $anMax + $i;
            $prev[$y] = max(0, round($reg['a'] * $y + $reg['b'], $met === 'duree_moy' ? 1 : 0));
        }
        $tendance = array_map(fn($x) => round(max(0, $reg['a'] * $x + $reg['b']), 1), $xs);
    }
}

/* =========================================================
   EXPORT CSV (périodique + personnalisé)
========================================================= */
if (isset($_GET['export']) && $_GET['export'] === 'csv' && in_array($type, ['periodique', 'personnalise'], true)) {
    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename="rapport_' . $type . '_' . date('Y-m-d') . '.csv"');
    $out = fopen('php://output', 'w');
    fprintf($out, chr(0xEF) . chr(0xBB) . chr(0xBF));
    fputcsv($out, $table['head']);
    foreach ($table['rows'] as $row)
        fputcsv($out, $row);
    fclose($out);
    exit();
}


/* =========================================================
   EXPORT EXCEL (.xlsx) + PDF : les 4 types de rapports
   À coller juste APRÈS le bloc « EXPORT CSV » (celui qui finit par exit(); })
   et AVANT « // ---------- Configuration du graphique »
========================================================= */
if (isset($_GET['export']) && in_array($_GET['export'], ['xlsx', 'pdf'], true)) {
    require_once __DIR__ . '/../includes/export_lib.php';

    $sousTitre = [];
    $sections = [];

    if ($type === 'periodique') {
        $sousTitre[] = ($freq === 'annuel')
            ? 'Annuel : ' . reset($labels) . ' à ' . end($labels)
            : 'Mensuel : année ' . $annee;
        $totFilms = 0;
        foreach ($table['rows'] as $r) {
            $totFilms += (int) $r[1];
        }
        $sections[] = [
            'name' => 'Périodique',
            'heading' => 'Films sortis par période',
            'head' => $table['head'],
            'rows' => $table['rows'],
            'total' => ['TOTAL', $totFilms, '', '', '', '', ''],
        ];

    } elseif ($type === 'personnalise') {
        $sousTitre[] = ucfirst($entite) . ' : ' . $groupes[$entite][$groupe];
        if ($entite === 'films') {
            if ($cd !== null || $cf !== null) {
                $sousTitre[] = 'Années : ' . ($cd ?? '…') . ' – ' . ($cf ?? '…');
            }
            foreach ($categories as $c) {
                if ((int) $c['id_categorie'] === $cc) {
                    $sousTitre[] = 'Catégorie : ' . $c['nom_categorie'];
                }
            }
            foreach ($langues as $l) {
                if ((int) $l['id_langue'] === $cl) {
                    $sousTitre[] = 'Langue : ' . $l['nom_langue'];
                }
            }
        }
        $part = $total > 0 ? 100 : 0;
        $sections[] = [
            'name' => 'Personnalisé',
            'heading' => $groupes[$entite][$groupe],
            'head' => $table['head'],
            'rows' => $table['rows'],
            'total' => ($entite === 'films') ? ['TOTAL', $total, '', $part] : ['TOTAL', $total, $part],
        ];

    } elseif ($type === 'comparatif') {
        $libModes = ['periodes' => 'Comparaison de périodes', 'realisateurs' => 'Comparaison de réalisateurs', 'acteurs' => "Comparaison d'acteurs"];
        $sousTitre[] = $libModes[$mode] . ' : ' . $cmp[0]['label'] . '  contre  ' . $cmp[1]['label'];
        $rowsCmp = [];
        foreach ($METS as $k => $lib) {
            $va = (float) ($cmp[0]['stats'][$k] ?? 0);
            $vb = (float) ($cmp[1]['stats'][$k] ?? 0);
            $rowsCmp[] = [$lib, $va, $vb, round($vb - $va, 1), variation($va, $vb)];
        }
        $sections[] = [
            'name' => 'Comparaison',
            'heading' => 'Indicateurs comparés',
            'head' => ['Indicateur', $cmp[0]['label'], $cmp[1]['label'], 'Écart', 'Variation'],
            'rows' => $rowsCmp,
        ];
        foreach ($cmp as $i => $c) {
            $L = ($i === 0) ? 'A' : 'B';
            $rowsCat = [];
            foreach ($c['cats'] as $t) {
                $rowsCat[] = [$t['libelle'], (int) $t['nb']];
            }
            $sections[] = [
                'name' => 'Catégories ' . $L,
                'heading' => 'Top catégories ' . $L . ' : ' . $c['label'],
                'head' => ['Catégorie', 'Nombre de films'],
                'rows' => $rowsCat,
            ];
        }

    } else { // prevision
        $sousTitre[] = $PM[$met] . ' : horizon ' . $h . ' an(s)';
        $rowsPrev = [];
        if (!empty($ok)) {
            foreach ($xs as $i => $an) {
                $rowsPrev[] = [$an, 'Réel', $ys[$i], $tendance[$i] ?? ''];
            }
            foreach ($prev as $an => $v) {
                $rowsPrev[] = [$an, 'Prévision', $v, $v];
            }
        }
        $sections[] = [
            'name' => 'Prévisions',
            'heading' => 'Réel et prévisions',
            'head' => ['Année', 'Type', 'Valeur', 'Tendance'],
            'rows' => $rowsPrev,
            'note' => !empty($ok)
                ? sprintf("Méthode : régression linéaire sur %d années (pente %s par an, R² = %s). Une prévision n'est qu'une estimation basée sur le passé.",
                    count($xs), number_format($reg['a'], 2, ',', ' '), number_format($reg['r2'], 2, ',', ' '))
                : 'Pas assez de données : il faut des films répartis sur au moins 3 années différentes.',
        ];
    }

    $rapport = [
        'title' => $titres[$type][1],
        'subtitle' => implode('   |   ', array_filter($sousTitre)),
        'sections' => $sections,
    ];
    $nomFichier = 'rapport_' . $type . '_' . date('Y-m-d');

    // Journal des activités (facultatif : ignoré si la fonction n'existe pas)
    try {
        $np = __DIR__ . '/../includes/notification.php';
        if (is_file($np)) {
            require_once $np;
        }
        if (function_exists('addHistoriqueAction') && isset($_SESSION['user_id'])) {
            addHistoriqueAction($pdo, $_SESSION['user_id'], 'export', 'rapport', null, $nomFichier,
                'Export ' . strtoupper($_GET['export']) . ' : ' . $titres[$type][1]);
        }
    } catch (Throwable $ex) {
        // le journal ne doit jamais empêcher l'export
    }

    try {
        if ($_GET['export'] === 'xlsx') {
            bm_xlsx_output($nomFichier . '.xlsx', $rapport);
        } else {
            bm_pdf_output($nomFichier . '.pdf', $rapport);
        }
    } catch (Throwable $ex) {
        $erreurs[] = 'Export impossible : ' . $ex->getMessage();   // affiché dans le bandeau d'erreur existant
    }
}


// ---------- Configuration du graphique (envoyée au JavaScript) ----------
$jsCfg = null;
if ($type === 'prevision') {
    if (!empty($ok)) {
        $jsCfg = [
            'kind' => 'forecast',
            'labels' => array_map('strval', array_merge($xs, array_keys($prev))),
            'reel' => array_map('floatval', $ys),
            'prev' => array_values($prev),
            'tendance' => $tendance,
            'height' => 340,
        ];
    }
} elseif ($chart['datasets']) {
    $jsCfg = [
        'kind' => 'bar',
        'labels' => array_map('strval', $chart['labels']),
        'datasets' => $chart['datasets'],
        'horizontal' => $chart['horizontal'],
        'height' => $chart['horizontal'] ? max(340, count($chart['labels']) * 30 + 60) : 340,
    ];
}

$titres = [
    'periodique' => ['fa-calendar-alt', 'Rapports périodiques'],
    'personnalise' => ['fa-sliders-h', 'Rapports personnalisés'],
    'comparatif' => ['fa-balance-scale', 'Analyse comparative'],
    'prevision' => ['fa-chart-line', 'Prévisions statistiques'],
];

// Index de la colonne "Part (%)" (affichée avec une barre de progression)
$partIdx = array_search('Part (%)', $table['head'], true);
?>
