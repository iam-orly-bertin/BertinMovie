                <div class="hx-empty">
                    <div class="hx-empty-ico"><i class="fas fa-chart-simple"></i></div>
                    <h3>Aucune donnée</h3>
                    <p>Aucun résultat pour ces critères. Essayez de les modifier.</p>
                </div>
            <?php endif; ?>
        <?php endif; ?>

        <?php /* ================= COMPARATIF ================= */ if ($type === 'comparatif'): ?>
            <div class="rpt-panel rpt-noprint">
